{
  "family": "ecommerce-admin-task-definition",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::865230234414:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "ecommerce-admin",
      "image": "admin-container-image-placeholder",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "REACT_APP_API_URL",
          "value": "http://app-load-balancer-236200593.us-east-1.elb.amazonaws.com:8080"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecommerce-admin-task-definition",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
